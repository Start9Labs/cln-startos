ARG IMAGE
FROM ${IMAGE}
# Upstream's Node predates the November 2026 security release.
COPY --from=node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee /usr/local/bin/node /usr/local/bin/node
ENV NODE_VERSION=22.23.5
RUN [ "$(node --version)" = v22.23.5 ]
